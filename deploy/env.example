# video2listener 服务密钥
#
# 用法：
#   sudo cp deploy/env.example /etc/video2listener.env
#   sudo chmod 600 /etc/video2listener.env
#   编辑填入真实值后：sudo systemctl restart video2listener
#
# 注意：src/config.py 只读取下面这三个变量名。名字写错不会有任何报错，
# 服务会表现为「未配置 API Key」。变量名必须与 src/config.py 的 env_map 一致。

# 翻译用 LLM（DeepSeek）
VIDEO2LISTENER_DEEPSEEK_API_KEY=
VIDEO2LISTENER_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 语音合成（Fish Audio TTS，默认）。留空则回退到免费 edge-tts。
VIDEO2LISTENER_FISH_API_KEY=
VIDEO2LISTENER_FISH_BASE_URL=https://api.fish.audio/v1

# 兼容备选：MiMo TTS
VIDEO2LISTENER_MIMI_API_KEY=
