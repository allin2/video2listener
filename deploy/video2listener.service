[Unit]
Description=video2listener - YouTube to Chinese Podcast Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/path/to/video2listener
Environment=PATH=/path/to/venv/bin:/usr/local/bin:/usr/bin:/bin
# 密钥通过 EnvironmentFile 注入。不要在单元文件里写 `VAR=` 空值——
# 显式空值会把外部传入的同名变量覆盖为空字符串，服务会静默拿不到密钥。
# 初始化：sudo cp deploy/env.example /etc/video2listener.env
#         sudo chmod 600 /etc/video2listener.env 然后填入真实值
# 前缀 `-` 表示该文件不存在时不视为失败，便于先在页面上配置密钥的场景。
EnvironmentFile=-/etc/video2listener.env
ExecStart=/path/to/venv/bin/uvicorn src.web.server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
